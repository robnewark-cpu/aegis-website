{
  // Wrangler v3 / v4 config for aegis-form-worker
  "name": "aegis-form-worker",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",

  // Non-secret configuration — safe to commit.
  //
  // REQUIRED secrets (set via CLI, never commit values):
  //   wrangler secret put RESEND_API_KEY    --name aegis-form-worker
  //   wrangler secret put ANTHROPIC_API_KEY --name aegis-form-worker
  //
  // FROM_EMAIL domain must be verified in Resend: resend.com/domains
  //
  // STRIPE PAYMENT LINKS
  // Create a Payment Link in your Stripe dashboard for each service
  // (Stripe Dashboard → Payment Links → + Create), then paste the URL here.
  // Any service without its own link falls back to STRIPE_BOOKING_LINK.
  // All links are optional — missing links show a "Contact Us" mailto button.
  "vars": {
    "FROM_EMAIL": "noreply@aegisglobalholdings.com",
    "TO_EMAIL":   "info@aegisglobalholdings.com",

    // Fallback for any service card without its own link — and for
    // GBP, Citations, Schema which don't have dedicated Stripe links yet.
    // Mapped to: "Aegis All-in-one Care Plan"
    "STRIPE_BOOKING_LINK": "https://buy.stripe.com/14A00l5K43MT1B926qffy01",

    // "AI Search & Content Retainer" (created 15:05) — closest match to AI audit/strategy
    // NOTE: $400 Deposit - AI Visibility Package exists but is currently INACTIVE in Stripe.
    //       Reactivate it at dashboard.stripe.com/payment-links and paste its URL here to
    //       replace this link with the more specific one.
    "STRIPE_LINK_AI_AUDIT": "https://buy.stripe.com/fZu8wRegA0AH93BbH0ffy05",

    // "AI Search & Content Retainer" (created 15:04) — mapped to content + schema rewrite
    // NOTE: Two links share the same Stripe name. Clarify which is which in Stripe
    //       if they have different prices, then update accordingly.
    "STRIPE_LINK_CONTENT_SCHEMA": "https://buy.stripe.com/7sYdRb4G0fvB1B99ySffy03",

    // No dedicated Stripe link yet — falls back to STRIPE_BOOKING_LINK above.
    // Create a GBP-specific Payment Link in Stripe and paste the URL here.
    "STRIPE_LINK_GBP": "",

    // "Website Mitigation - Deposit"
    "STRIPE_LINK_WEBSITE": "https://buy.stripe.com/5kQ9AV8WgdntenV6mGffy02",

    // No dedicated Stripe link yet — falls back to STRIPE_BOOKING_LINK above.
    "STRIPE_LINK_CITATIONS": "",

    // No dedicated Stripe link yet — falls back to STRIPE_BOOKING_LINK above.
    "STRIPE_LINK_SCHEMA": "",

    // CTA for the "Discuss Annual Rates" section.
    // Point this to a Stripe Payment Link, a Calendly booking page, or leave
    // empty to fall back to STRIPE_BOOKING_LINK.
    "STRIPE_ANNUAL_LINK": ""
  }
}
